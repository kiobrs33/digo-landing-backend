# Servidor
PORT=4110
NODE_ENV=development
# Orígenes permitidos (separados por coma): landing HOGAR, landing EMPRESAS y panel admin.
# Producción: https://digo.net.pe,https://www.digo.net.pe,https://digoempresas.pe,https://www.digoempresas.pe,https://cms.digo.net.pe
CORS_ORIGINS=http://localhost:4111,http://localhost:4112,http://localhost:4113

# Base de datos (docker-compose.yml)
DATABASE_URL="postgresql://digo:digo@localhost:5433/digo_landing?schema=public"

# Sesión del panel
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=8h

# Correo saliente (en local: Mailpit, bandeja en http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Digo Telecom <notificaciones@digo.net.pe>"
# Avisos internos (nuevas consultas y reclamos)
MAIL_TEAM=team@digo.net.pe

# Primer administrador (lo crea `npm run db:seed`)
SEED_ADMIN_EMAIL=admin@digo.net.pe
SEED_ADMIN_PASSWORD=CambiaEsta123!

# URL pública de esta API (las imágenes del modo local se sirven desde aquí)
PUBLIC_URL=http://localhost:4110

# Cloudinary. Si queda vacío, las imágenes se guardan en la carpeta uploads/ (solo desarrollo).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=digo

# Deploy Hooks de Vercel (botón "Publicar"). Vacíos = la publicación se simula.
VERCEL_DEPLOY_HOOK_HOGAR=
VERCEL_DEPLOY_HOOK_EMPRESAS=

# Mikrowisp: API de clientes (conciliación de pagos del BCP). Token de Ajustes > API.
MIKROWISP_URL=https://app.digo.net.pe
MIKROWISP_TOKEN=

# WhatsApp Cloud API (Meta) de Digo: envíos masivos. Token permanente de un usuario del sistema.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ID=
WHATSAPP_TOKEN=

# WhatsApp Cloud API (Meta) de Speednet: envíos masivos. Token permanente de un usuario del sistema.
SPEEDNET_WHATSAPP_PHONE_NUMBER_ID=
SPEEDNET_WHATSAPP_BUSINESS_ID=
SPEEDNET_WHATSAPP_TOKEN=
